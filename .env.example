# Export these variables in your shell; the worker does not auto-load .env.
MEL_AWS_REGION=us-east-1
MEL_CONFIG_PATH=config/agent.yaml
# Fallback for model IDs left null in YAML. Explicit YAML IDs take precedence.
MEL_BEDROCK_MODEL_ID=openai.gpt-6-luna
# Optional local override; deployed workers use the account's default project.
MEL_BEDROCK_PROJECT_ID=default
MEL_DATABASE_HOST=localhost
MEL_DATABASE_PORT=5432
MEL_DATABASE_NAME=farmerchat
MEL_DATABASE_USER=mel
MEL_DATABASE_PASSWORD=mel-local-only
# Local compose only; Fargate sets verify-full and the RDS CA bundle.
MEL_DATABASE_SSLMODE=disable
